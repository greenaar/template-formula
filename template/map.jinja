# -*- coding: utf-8 -*-
# vim: ft=jinja

{#- Get the `tplroot` from `tpldir` #}
{%- set tplroot = tpldir.split('/')[0] %}
{%- import_yaml tplroot ~ "/defaults.yaml" as default_settings %}
{%- import_yaml tplroot ~ "/osarchmap.yaml" as osarchmap %}
{%- import_yaml tplroot ~ "/osfamilymap.yaml" as osfamilymap %}
{%- import_yaml tplroot ~ "/osmap.yaml" as osmap %}
{%- import_yaml tplroot ~ "/osfingermap.yaml" as osfingermap %}

{#- Cascade, lowest to highest priority: defaults.yaml -> osarchmap.yaml
   -> osfamilymap.yaml -> osmap.yaml -> osfingermap.yaml ->
   pillar's `template:lookup`. Each grains.filter_by call falls back to
   the `default_settings` dict (keyed by tplroot) whenever nothing more
   specific matches, and `merge=` deep-merges the more specific layer on
   top of it. #}
{%- set defaults = salt['grains.filter_by'](default_settings,
  default=tplroot,
  merge=salt['grains.filter_by'](osarchmap, grain='osarch',
    merge=salt['grains.filter_by'](osfamilymap, grain='os_family',
      merge=salt['grains.filter_by'](osmap, grain='os',
        merge=salt['grains.filter_by'](osfingermap, grain='osfinger',
          merge=salt['pillar.get'](tplroot ~ ':lookup', default={})
        )
      )
    )
  )
) %}

{#- Merge the formula's own pillar tree on top of everything above.
   `merge=True` does a recursive dict merge instead of a full replace,
   so a pillar author only has to specify the keys they want to change. #}
{%- set template = salt['pillar.get'](tplroot, default=defaults, merge=True) %}
