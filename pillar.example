# -*- coding: utf-8 -*-
# vim: ft=yaml
---
# Rename this key to your formula's name when you copy the directory.
template:
  # Package(s) to install. Usually left to osfamilymap.yaml rather than
  # set here, since the name differs per platform.
  pkg:
    name:
      - apache2

  # The account the service runs as. Created as a system user with no
  # login shell.
  app:
    user: myuser
    group: mygroup

  service:
    name: myapp
    enable: true

  # Values a config template would consume. Vary these per environment
  # through pillar targeting, not through a custom grain.
  config:
    port: 8080
    debug: true

  # Alternative override point. `lookup` sits between the os*map.yaml
  # files and the main pillar tree in the merge cascade, which makes it
  # a convenient place for per-role overrides that shouldn't look like
  # normal user configuration.
  lookup:
    service:
      name: myapp
